{
  "name": "hz-learning-helper",
  "version": "1.35.3",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run lint && npm run build && node test.mjs && node --test tests/*.test.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.mjs\" test.mjs build.mjs preview.mjs eslint.config.js \"tools/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.mjs\" test.mjs build.mjs preview.mjs eslint.config.js \"tools/**/*.js\""
  },
  "keywords": [],
  "author": "",
  "description": "面向杭州专业技术人员学习新干线的课程管理与学时查看助手",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "11.0.1"
  }
}
